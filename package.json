{
  "name": "haze-guide-sg",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node tooling/git-hooks.js install",
    "check": "npm run format:check && npm test",
    "security:setup": "node tooling/codeql.js setup",
    "security:codeql": "node tooling/codeql.js scan",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
